          "            continue;",
          "        }",
          "        crate::validate::validate_name(&member.name)?;",
          "        if !names.insert(member.name) || names.len() > 16 {",
          "            return Err(refused(\"duplicate_recipient_or_worker_budget\"));",
          "        }",
          "    }",
          "    Ok(names)"
        ]
