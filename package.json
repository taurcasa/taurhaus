{
  "name": "taurhaus",
  "private": true,
  "version": "0.8.7",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.2.20",
  "engines": {
    "node": "^20.12.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('bun/')){console.error('Use bun install (not npm/pnpm/yarn) in taurhaus'); process.exit(1)}\"",
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "vite",
    "dev:visual": "vite --config vite.visual.config.js",
    "dev:tauri": "tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bun run lint:structure",
    "lint:structure": "bun run lint:knip && bun run lint:deps",
    "lint:knip": "knip",
    "lint:deps": "bun run check:node && dependency-cruiser --no-config --include-only '^src' --output-type err-long src",
    "typecheck": "svelte-check",
    "check": "bun run typecheck"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "^2.0.9",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/mocha-framework": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "dependency-cruiser": "^17.3.8",
    "jsdom": "26.1.0",
    "knip": "^5.86.0",
    "playwright": "^1.58.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "dompurify": "^3.3.2"
  },
  "trustedDependencies": [
    "esbuild",
    "edgedriver",
    "geckodriver"
  ],
  "dependencies": {
    "@shikijs/markdown-it": "^3.22.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "dompurify": "^3.3.2",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.12.3",
    "shiki": "^3.22.0"
  }
}
