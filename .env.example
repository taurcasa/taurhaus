# Copy to `.env` in the repo root and fill in the key: `cp .env.example .env`.
#
# `.env` is gitignored and is read by exactly one thing: the documentation
# infographic generator (`scripts/generate-infographics.py`, `just infographics`).
# Neither the taurhaus app nor the daemon ever reads this file or this key.
# Real environment variables win over the values below.
#
# Workflow: docs/operations/infographics.md

# Required. OpenAI API key with access to the Images API.
OPENAI_API_KEY=

# Image model used for regeneration.
OPENAI_IMAGE_MODEL=gpt-image-2

# Output geometry. Allowed: 1024x1024 | 1536x1024 | 1024x1536, plus the true
# 16:9 pair gpt-image-2 accepts: 2048x1152 | 1152x2048.
# 2048x1152 is exact 16:9 — the shape every manifest entry declares. A size of a
# different shape is refused per entry unless you pass --allow-aspect-change,
# which reshapes the image and rewrites the entry's aspect_ratio to match.
OPENAI_IMAGE_SIZE=2048x1152

# Rendering quality. Allowed: low | medium | high. Cost scales with this.
OPENAI_IMAGE_QUALITY=high

# Optional. Point at a compatible gateway; defaults to the OpenAI API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Post-processing for the committed JPEGs.
TAURHAUS_INFOGRAPHIC_MAX_WIDTH=1600
TAURHAUS_INFOGRAPHIC_JPEG_QUALITY=85
